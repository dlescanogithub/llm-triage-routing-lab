# Copy to .env locally if you want. Never commit .env.
# Live mode is off unless LIVE_LLM=1. CI and tests do not set these.

LIVE_LLM=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_CLASSIFIER=
LLM_MODELS=
MAX_LIVE_SPEND_USD=
# These two apply only to LLM_MODEL. They are not a shared rate for every model.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
# One row per model: name=input_usd_per_mtok:output_usd_per_mtok, separated by commas.
# Every name in LLM_MODELS needs a row before any call. The estimate ignores cached tokens.
LLM_MODEL_PRICE_TABLE=
MAX_LIVE_TOKENS=

FORCE_HUMAN_REVIEW=0
TRIAGE_TAU=
TRIAGE_MAX_ATTEMPTS=3
TRIAGE_BACKOFF_CAP_S=0.05
TRIAGE_MAX_TOKENS_PER_TICKET=8000
TRIAGE_BENIGN_FP_BUDGET=0.10
TRIAGE_AUTO_ERROR_BUDGET=0.02
TRIAGE_DATA_DIR=
TRIAGE_LOG_LEVEL=INFO
